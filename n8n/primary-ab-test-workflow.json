      },
      "id": "10",
      "name": "Log Assignment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        810,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $json;\n\nreturn [{\n  ...input,\n  telegram_id: input.telegram_id || input.user?.telegram_id || $('Normalize Incoming').first().json.telegram_id,\n  username: input.username || input.user?.username || $('Normalize Incoming').first().json.username || '',\n  experiment_name: input.experiment_name || input.user?.experiment_name || 'telegram_onboarding_ab',\n  variant: input.variant || input.user?.variant || 'control',\n  onboarding_step: Number(input.onboarding_step ?? input.user?.onboarding_step ?? 0),\n  onboarding_completed: !!(input.onboarding_completed ?? input.user?.onboarding_completed ?? false),\n}];"
      },
      "id": "11",
      "name": "Resolve Active User",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        120
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.variant}}",
                    "rightValue": "control",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "control"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.variant}}",
                    "rightValue": "test",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "test"
            }
          ]
        }
      },
