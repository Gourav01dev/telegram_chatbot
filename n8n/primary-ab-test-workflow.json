        "jsonBody": "={{ { telegram_id: $('Resolve Active User').first().json.telegram_id, event_name: 'welcome_seen', experiment_name: $('Resolve Active User').first().json.experiment_name || 'telegram_onboarding_ab', variant: 'control', event_properties: { message_type: 'generic_welcome' } } }}"
      },
      "id": "14",
      "name": "Log Control Welcome",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1730,
        20
      ]
