      "id": "1",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        -1280,
        120
      ],
      "credentials": {
        "telegramApi": {
          "id": "replace-with-your-credential-id",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const m = $json.message || {};\nconst from = m.from || {};\nconst text = (m.text || '').trim();\n\nreturn [{\n  telegram_id: String(from.id || ''),\n  username: from.username || '',\n  text,\n  is_command: text.startsWith('/'),\n  text_length: text.length,\n  event_name: 'user_message_received',\n  experiment_name: 'telegram_onboarding_ab',\n  ts: new Date().toISOString()\n}];"
      },
      "id": "2",
      "name": "Normalize Incoming",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1050,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL + '/rest/v1/bot_events'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { telegram_id: $json.telegram_id, event_name: 'user_message_received', experiment_name: $json.experiment_name, variant: null, event_properties: { text_length: $json.text_length, has_command: $json.is_command } } }}"
      },
      "id": "3",
      "name": "Log Inbound Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -820,
        120
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL + '/rest/v1/bot_users?telegram_id=eq.' + $json.telegram_id + '&select=*'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            }
          ]
        }
      },
      "id": "4",
      "name": "Get Existing User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "alwaysOutputData": true,
      "position": [
        -590,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const incoming = $('Normalize Incoming').first().json;\nconst rows = $input.all().map((i) => i.json);\n\n// With \"Always Output Data\" enabled, empty query results can look like [{}]\nconst hasRealUser =\n  rows.length > 0 &&\n  rows[0] &&\n  Object.keys(rows[0]).length > 0 &&\n  !!rows[0].telegram_id;\n\nconst user = hasRealUser ? rows[0] : null;\n\nreturn [{\n  ...incoming,\n  user_exists: !!user,\n  user,\n}];"
      },
      "id": "5",
      "name": "Merge User Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -360,
        120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.user_exists}}",
              "operation": "isFalse"
            }
          ]
        }
      },
      "id": "6",
      "name": "Is New User?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.1,
      "position": [
        -120,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.statsig.com/v1/check_gate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "STATSIG-API-KEY",
              "value": "={{$env.STATSIG_SERVER_SECRET_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { user: { userID: $json.telegram_id }, gateName: $env.STATSIG_GATE_NAME || 'telegram_onboarding_ab' } }}"
      },
      "id": "7",
      "name": "Statsig Assign",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        120,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const base = $('Merge User Context').first().json;\nconst enabled = !!($json?.gateValue ?? $json?.value ?? false);\nconst variant = enabled ? 'test' : 'control';\n\nreturn [{\n  ...base,\n  variant,\n  onboarding_step: 0,\n  onboarding_completed: false\n}];"
      },
      "id": "8",
      "name": "Build New User",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        350,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL + '/rest/v1/bot_users?on_conflict=telegram_id'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { telegram_id: $json.telegram_id, username: $json.username, experiment_name: $json.experiment_name, variant: $json.variant, onboarding_step: 0, onboarding_completed: false } }}"
      },
      "id": "9",
      "name": "Insert User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        580,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL + '/rest/v1/bot_events'}}",
