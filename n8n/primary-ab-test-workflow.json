    {
      "parameters": {
        "jsCode": "const step = Number($json.onboarding_step || 0);\nlet message = '';\nlet nextStep = step;\nlet completed = false;\nlet eventName = 'onboarding_step_seen';\n\nif (step <= 0) {\n  message = 'Step 1/3: Welcome to CalorAI. Tell me your main health goal in one line (fat loss, maintenance, or muscle gain).';\n  nextStep = 1;\n} else if (step === 1) {\n  message = 'Step 2/3: Great. Any dietary preference? (veg, non-veg, vegan, no preference)';\n  nextStep = 2;\n} else if (step === 2) {\n  message = 'Step 3/3: What is your usual wake-up time?';\n  nextStep = 3;\n  completed = true;\n  eventName = 'onboarding_completed';\n} else {\n  message = 'Onboarding complete. Send your meal as: MealName - Time - Items';\n  nextStep = 3;\n  completed = true;\n  eventName = 'onboarding_completed';\n}\n\nreturn [{\n  ...$json,\n  onboarding_step: nextStep,\n  onboarding_completed: completed,\n  outbound_text: message,\n  onboarding_event: eventName\n}];"
      },
